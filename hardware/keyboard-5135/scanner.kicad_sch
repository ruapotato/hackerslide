	(text "TCA8418 keypad scanner, FPC to carrier" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "e55ad1d3-018e-5d40-ae0f-347ed13a6af8"))
	(text "TCA8418RTW pins 1-8 = ROW7..ROW0, 9-18 = COL0..COL9 (TI SCPS215G pin table)." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "799de9cd-806f-51b3-aadb-6d5497938a43"))
	(text "VCC 3.3 V: with a diode in series the row low level is VF + VOL, too high for 1.8 V logic." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "3c583c6e-b99a-51f0-b749-95bfe33496b9"))
	(text "Unused ROW6/ROW7 are tied to VCC through 100k as the datasheet asks." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "2e66b9ae-9c1a-50d9-a123-8877a141b53d"))
	(text "The pins are rated 2 kV HBM only: U2 clamps the cable signals, and the top plate copper is grounded" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "aa5900fa-2029-55fd-8a36-87303a8dae86"))
	(text "through the metal spacers H1-H4." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "983ac599-c99e-57df-8141-2d959d44f2c4"))
	(text "FPC: J1 pin k connects to carrier J9 pin k. J1 is on the top side with its pin 1 toward the device" (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c6ad459f-2f88-580d-abfb-1281cf6fdccf"))
	(text "left, like J9, and the cable runs straight in X (see the carrier keyboard_link sheet)." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5fc454d8-abc9-534b-898d-8c7ba6968748"))
	(embedded_fonts no)
