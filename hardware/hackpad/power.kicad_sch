	(global_label "VBUS" (shape bidirectional) (at 175.26 152.4 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "0236b9d2-1d28-5028-8e73-5bf5422815e3") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 175.26 152.4 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "USB-C, charger, battery, fuel gauge, 3.3 V" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "124e299e-01fe-5af6-bea2-1fa8a16fd716"))
	(text "Carried over from the Linux design (same chips, same values) unless a line says otherwise." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a0101420-66ea-5de2-9990-c9ca06bf6df5"))
	(text "USB-C: device only, 5.1k on CC1/CC2. The charger never sees D+/D- (R203/R204 not fitted), so the input stays at 5 V" (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "31d8c52e-b6cf-5a79-a4ed-583370e0cf7d"))
	(text "    and the ILIM resistor caps it at about 0.755 A. A USB-C controller for power-delivery tricks is a later sheet." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "dbb0fb00-8fce-5d02-9172-fa52f6e9f642"))
	(text "USB data goes to the brain's USB1 port, the one its built-in loader uses. USB1_VBUS must never exceed 5.6 V." (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "799c3773-c23e-5bc0-8cc8-3cf0c213ec8b"))
	(text "Cell: GlobTek BL1950P4071611S1PCPT, 1950 mAh. Its plug is Molex Micro-Latch 2.00 mm (51065-0400): pins 1-2 red +," (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "d4de2a09-0b2b-5fb0-aeb7-ca165511306d"))
	(text "    3-4 black -. Header J4 mates with it; MEASURE the plug before first use. Header height not verified." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "328e3aaa-a1bc-50c7-98f3-28bdb3b939c7"))
	(text "    The charger resets to 2.05 A charge current; the input cap keeps the cell under about 1.25 A whatever the" (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "256ee500-9979-5e6f-9e5e-d8c956e96b28"))
	(text "    register says. CHECK the pack's maximum charge current and set the register lower in firmware." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "e85998bc-3826-5bb8-82ca-ec540a572111"))
	(text "U15 (eFuse, 1.86 A typical) limits everything fed from VSYS_LIM, as before: under the pack's 3.9 A rating and the" (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5b7a027a-4dbc-525b-aa8a-9f526ff51c38"))
	(text "    header's 2 A per contact." (exclude_from_sim no) (at 15.24 59.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "30ccc85f-7099-5dc1-a64f-a300d0cb1575"))
	(text "3.3 V: TPS63802 buck-boost from VSYS_LIM, TI reference values (0.47 uH, 511k / 91k = 3.31 V). The brain's PMIC_ON_REQ" (exclude_from_sim no) (at 15.24 63.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b71828ec-0e13-5e2b-8ab3-ba061a9ffe7e"))
	(text "    (1.8 V logic, high = on) enables it; the always-on 3.0 V supply U12 keeps that pin alive. PG is a test pad." (exclude_from_sim no) (at 15.24 67.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "d9679476-0d80-5229-a349-638b1d3c7fa0"))
	(text "Power key SW3: to the brain's ONOFF pin and to the charger's /QON (ship-mode exit), each through a Schottky." (exclude_from_sim no) (at 15.24 71.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "4b547f28-a53b-5b88-bda0-522b69612051"))
	(text "Charger and gauge interrupts are open drain, pulled up to the 1.8 V SNVS supply, on wake pads." (exclude_from_sim no) (at 15.24 75.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "e6dc0c70-4e49-5564-bd89-ca6b49404059"))
	(text "The USB-C socket is still the 3.26 mm one of the Linux design; the lower HRO TYPE-C-31-M-14 replaces it once its" (exclude_from_sim no) (at 15.24 80.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "9d897a70-032a-5e48-a8e4-3244314ed83a"))
	(text "    drawing is turned into a footprint." (exclude_from_sim no) (at 15.24 84.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "0dcdf385-2dca-5c6e-b4da-0240688421c6"))
	(embedded_fonts no)
)
