	(global_label "IOX_RST_N" (shape bidirectional) (at 162.56 109.22 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "a59fe006-5b3e-5ea2-b038-ca8a6b63559b") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 162.56 109.22 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "microSD card and port expanders" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "142dbf89-51cf-5990-a66e-63e1e372177a"))
	(text "microSD on USDHC1 (3.3 V signalling only; the pad bank NVCC_SD1 is fixed at 3.3 V). Card detect is a switch to ground" (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "e9f40ecd-e587-533d-9f13-fa0c95d0fdbf"))
	(text "    on a 1.8 V wake pad, pulled up to the SNVS supply. Socket and protection as in the Linux design." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "e9640fa5-e075-5a2b-b0b2-a9c6de52f473"))
	(text "Port expanders: two TCA6416A on the I2C_P bus (0x20 and 0x21) carry the slow control lines the brain has no pads" (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b7092dc2-3063-5a9d-bcc2-05bd2afc9e1d"))
	(text "    for. Their interrupt outputs are open drain and share one wake pad. Ports are inputs after reset, so every line" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c482b746-b98f-56a1-9309-cd340a935632"))
	(text "    that must have a level before the firmware runs has its own pull resistor on its own sheet." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "0780c7fe-893f-5c83-beee-66a5b2ac07d8"))
	(text "IOX_A bits so far: 0 keyboard reset, 1 touch reset, 2 front-light enable, 3 front-light fault, 4 battery limiter" (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ceaa5eef-288b-56c1-8f35-0026012c482e"))
	(text "    fault, 5 3.3 V good, 6 codec interrupt. The rest, and all of IOX_B, wait for the radio and sensor sheets." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5a1aabb2-8ea4-5bc2-9d2e-cdb8d76a23bb"))
	(embedded_fonts no)
)
