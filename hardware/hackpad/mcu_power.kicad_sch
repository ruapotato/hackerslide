	(global_label "VDD_SOC" (shape bidirectional) (at 312.42 355.6 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "d7dfcac0-a527-579e-a5ab-d307d9a12ae2") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 312.42 355.6 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "Brain: supplies and decoupling" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "46ede1cf-3502-592c-872b-371dd5c5c51e"))
	(text "Follows hardware/hackpad/data/power.md. Decoupling per rail is the hardware guide table (HDUG rev 2, table 1) plus" (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "7c05ec41-8400-50bb-97d0-e7ced041adfc"))
	(text "    the EVKB additions on the converter outputs. Place the 0402 parts under the balls named in that table." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "1b9edc85-95f3-5e68-ba99-9a522c6b943e"))
	(text "VDD_SOC is made by the chip itself (DCDC_DIG, about 1.1 V at 800 MHz) through L1." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f185721e-d2c6-5f12-8541-14be1fe5ac5c"))
	(text "The chip also makes 1.8 V (DCDC_ANA) but only for on-chip loads up to 150 mA. As on the EVKB it gets its" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ce6e1c31-b418-50db-8335-a4fe6ffc6070"))
	(text "    capacitors and is otherwise unused: the 1.8 V inputs take +1V8 from the LDO U2." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "6ac4aded-abae-55b1-8a04-c7318b9b190c"))
	(text "Power-up order (data sheet 4.2.1): SNVS, LPSR and DCDC_IN may be one 3.3 V net, as here. DCDC_PSWITCH must rise" (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "46e807eb-95a9-5077-a6c5-0ba4478626a3"))
	(text "    5-40 ms after DCDC_IN: R1 30k x C1 220n = 6.6 ms, the EVKB values." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "36ca2300-29ce-5fe3-a21b-36957132f2ca"))
	(text "DEPARTS from the EVKB: NVCC_DISP1 is on +3V3 (EVKB: 1.8 V) because nothing here needs that bank at 1.8 V." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "6a261f70-bf89-5f93-b592-e69c5f411ee6"))
	(text "MIPI is unused (the e-paper panel is SPI): VDD_MIPI_1P8 and VDD_MIPI_1P0 go to GND through 10k (data sheet table 6)." (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "4c316053-fc57-51d0-a37f-7914914a210e"))
