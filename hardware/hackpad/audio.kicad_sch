	(global_label "AVDD_CODEC" (shape bidirectional) (at 220.98 114.3 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "52efb89e-fc7b-549f-9795-2c32e9cc5416") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 220.98 114.3 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "Audio out: ES8316 codec and 3-pole headphone jack" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "80b879f3-6cd8-5719-96b6-199035723681"))
	(text "Audio OUT only (David 2026-11-26): 3-pole jack sunk into a notch in the board edge, about 2.15 mm above the board." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "86b38fd9-2747-58c5-8c2f-1d7cb153270b"))
	(text "Codec circuit carried over from the Linux design (Everest application circuit): AVDD/PVDD 3.3 V, DVDD/CPVDD 1.8 V," (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "4d421b7e-1cc9-5685-b118-1e7b1588d99b"))
	(text "    I2C address 0x10 on the I2C_U bus, master clock required. Its two recording inputs are grounded through" (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ada0db0c-14b6-57d9-8cad-c40d89a4bb7a"))
	(text "    capacitors: the built-in microphones go straight to the brain." (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "92400ac6-6976-51cd-b196-ce4e7f57f126"))
	(text "The master clock pad is also boot strap 9 (pulled low by 10k on the brain sheet); the codec pin is an input." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b4c134cf-b589-5a83-815c-ca57f2fb26b8"))
	(text "Jack terminals from the XKB drawing: 1 sleeve, 2 and 3 signal, 4-5 an isolated switch. Which of 2 and 3 is the tip" (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "d53142c2-0b6a-5710-965c-e1f769b57561"))
	(text "    is not stated: a wrong guess swaps left and right, which the firmware can swap back. Whether the switch is" (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a152e9d7-510e-5360-beea-60098188761a"))
	(text "    closed with or without a plug is not stated either: the firmware learns the polarity." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ad701a92-a172-5b2a-b960-2adb0daa76e4"))
	(text "HPGND joins GND only through R236, placed at the jack." (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "45cd7695-1a69-5768-8af6-1c92e9f5185a"))
	(embedded_fonts no)
)
