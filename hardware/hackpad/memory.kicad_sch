	(text "SDRAM 64 MB and boot flash" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "dee7eaaf-01d9-55aa-8379-fb30b83e16c9"))
	(text "SDRAM exactly as on the EVKB (hardware/hackpad/data/sdram.csv): two W9825G6KH, 16 bits each, forming one 32-bit bank" (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "6d12ae20-e939-53c0-b34e-67866021ea4d"))
	(text "    on SEMC_CS0. Pad for pad and pin for pin the same; the EVKB has no series resistors on this bus." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b063d8b4-a808-5dfc-bb94-355cff00673f"))
	(text "SEMC_DQS (ball J2) must stay unconnected: the chip loops its own clock back through that pad." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "27cff6ac-738e-5ae9-a10c-35da94295167"))
	(text "128 MB later: on B silicon a second bank may only use SEMC_CSX0 (ball L1) or SEMC_RDY (ball K1) as its chip select" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c2c23895-9605-5512-8a35-8b178551789e"))
	(text "    (erratum ERR052401). Not drawn yet." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "3de0da98-3d54-5a25-bc85-1abe18c2b898"))
	(text "Flash: FlexSPI1 port A on GPIO_SD_B2_06..11 (boot.md). W25Q128JW, 1.8 V, the part of the first EVKB revision." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "0e305973-ce10-5c4f-80ff-d6745973349f"))
	(text "    FLEXSPI1_A_DQS (ball E14) must stay unconnected for 133 MHz." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a0679e1d-5d28-5f06-acc9-f1f98c3a6f84"))
	(text "TODO before layout: check the W9825G6KH and W25Q128JW pin numbers against Winbond's data sheets (taken here from" (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "7b0d0f1b-dfca-51f5-8193-1974590220df"))
	(text "    KiCad's library symbols and the EVKB schematic)." (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "30eeb23c-bc75-5161-b093-3106f3c3d25d"))
