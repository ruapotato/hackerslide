	(global_label "ONOFF" (shape bidirectional) (at 167.64 91.44 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "0123c9ec-edf1-5565-9426-8ffa5c28b75f") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 167.64 91.44 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "Brain: clocks, reset, boot and debug" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "dbe916ba-bdc1-51ad-8cdd-344d0adb3d6a"))
	(text "Follows hardware/hackpad/data/power.md sections 5 and 7 and boot.md." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "76cee94d-007d-530c-bab2-215f214d8e21"))
	(text "24 MHz crystal as EVKB Y4 (8 pF load, 4.7 pF capacitors); 32.768 kHz crystal as EVKB Y5, its capacitors unfitted." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b9157f1b-6526-5af7-b12b-1f7ae5f5af07"))
	(text "    CRYSTAL PART NUMBERS TO BE CHOSEN from stock with those figures." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "2959a593-340c-58e0-93b0-48ba8bb74c2c"))
	(text "Boot: BOOT_MODE = 10 (run from the flash) by R20/R21. Holding SW1 while resetting gives 01, the serial loader on" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "77f40659-d126-5d63-bb86-f3aad420f6c6"))
	(text "    USB1 and LPUART1: SW1 lifts BOOT_MODE0 and Q1 pulls BOOT_MODE1 down." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "31ea3212-35b7-5b98-b405-05e0a5be40f1"))
	(text "The twelve BT_CFG pads must not float on a part with blank fuses: all zero selects QSPI flash on FlexSPI1." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c5ad0d74-56b4-5ef3-ac14-641731bfdc57"))
	(text "    10k to GND each. Anything put on those pads later must not pull them up while the chip leaves reset." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5d01e4ee-e482-5cdb-93b8-b201ce16a4dc"))
	(text "POR_B: 100n as on the EVKB and a reset button. NXP recommends a supervisor with its threshold above 2.6 V: TODO." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a0116bc7-78d5-56c2-9323-d14b8aa8ad66"))
	(text "ONOFF is the power key (short press: on / interrupt; about 5 s: forced off). PMIC_ON_REQ will enable the 3.3 V" (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c297523d-4d41-57fd-b71f-0430ea62893d"))
	(text "    regulator on the power sheet. SWD on test pads; console on LPUART1, the port the serial loader also uses." (exclude_from_sim no) (at 15.24 59.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "9ba90ed4-de8a-5d73-91d7-715b056f2d7d"))
	(embedded_fonts no)
)
