	(global_label "ONOFF" (shape bidirectional) (at 287.02 91.44 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "24066a60-e3f4-5817-8cfc-5393dd1eece3") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 287.02 91.44 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "Brain: clocks, reset, boot and debug" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "dbe916ba-bdc1-51ad-8cdd-344d0adb3d6a"))
	(text "Follows hardware/hackpad/data/power.md sections 5 and 7 and boot.md." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "76cee94d-007d-530c-bab2-215f214d8e21"))
	(text "24 MHz crystal: 8 pF load with NXP's 4.7 pF capacitors; computed to run a little fast: MEASURE on the first board." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "8358250f-e930-5ba6-8dce-f6c491755491"))
	(text "32.768 kHz crystal: 7 pF load, 10 pF capacitors fitted (NXP's board leaves them off; the chip adds no load of its own)." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ae616692-70ee-54fa-8f37-e1a242486883"))
	(text "Boot: BOOT_MODE = 10 (run from the flash) by R20/R21. Holding SW1 while resetting gives 01, the serial loader on" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "77f40659-d126-5d63-bb86-f3aad420f6c6"))
	(text "    USB1 and LPUART1: SW1 lifts BOOT_MODE0 and Q1 pulls BOOT_MODE1 down." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "31ea3212-35b7-5b98-b405-05e0a5be40f1"))
	(text "The twelve BT_CFG pads must not float on a part with blank fuses: all zero selects QSPI flash on FlexSPI1." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c5ad0d74-56b4-5ef3-ac14-641731bfdc57"))
	(text "    10k to GND each. Anything put on those pads later must not pull them up while the chip leaves reset." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5d01e4ee-e482-5cdb-93b8-b201ce16a4dc"))
	(text "POR_B: supervisor U10 (3.0 V threshold, about 62 ms delay from C86) drives it open drain; the reset button is on its" (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "9c43fc40-6ed6-5d91-8553-c9aa13bf3b61"))
	(text "    manual-reset input. DEPARTS from the EVKB, whose supervisor power-cycles the 3.3 V supply instead." (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c576b7ca-f486-5e42-a852-4ef664771545"))
	(text "ONOFF is the power key (short press: on / interrupt; about 5 s: forced off). PMIC_ON_REQ will enable the 3.3 V" (exclude_from_sim no) (at 15.24 59.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5f5f5e2f-2d97-5ac2-9c0a-cfaac7750639"))
	(text "    regulator on the power sheet. SWD on test pads; console on LPUART1, the port the serial loader also uses." (exclude_from_sim no) (at 15.24 63.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "1052ea28-ea6d-57a5-9754-dd2225b05ad1"))
	(embedded_fonts no)
)
