	(text "Keyboard: 47 keys on a TCA8418 scanner" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "2ea692e1-b623-54fd-a858-d7e15e28e592"))
	(text "Layout and matrix positions come from hp_layout.py (N810-style rows, Esc, Tab, four arrows and OK)." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "36d4da41-9b39-589f-80e2-7dc700b3269f"))
	(text "Each key: switch in series with a diode, anode toward the row; the scanner drives columns low and reads rows." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "cfef904e-ca5b-57a7-a99c-29c3d170272b"))
	(text "    Both Space switches share one matrix position and one diode." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "1da00e97-4c0a-5857-bada-473a77b4ab64"))
	(text "Scanner at 3.3 V on the I2C_U bus, address 0x34. Its interrupt is open drain and goes to a 1.8 V wake pad of the" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f3e2d68d-d0b4-550c-8e06-f0de29aa7813"))
	(text "    brain, pulled up to the SNVS supply. Reset comes from a port expander (later sheet); pulled up here." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5ecc950b-485f-5192-90f6-65cae79fd96f"))
	(text "Unused scanner rows and columns are tied to +3V3 through 100k as the TI data sheet asks." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "16f2ee2a-5170-5ed7-9d9a-a72990bee85a"))
	(embedded_fonts no)
)
