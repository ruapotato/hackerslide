	(global_label "FL_INT_N" (shape bidirectional) (at 386.08 48.26 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "250a030c-3c9e-5a56-9cd5-eda061f43d8c") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 386.08 48.26 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "Display link: e-paper, touch, front light" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "783a437a-0066-51fb-8a26-1fa538266273"))
	(text "The e-paper drive circuit is on the lid board (hackpad_lid_design.py). J2 is the 20-way cable to it through the" (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "cd20f0e9-bb96-53d7-b682-a691c2ac803f"))
	(text "    slider; pin k here is pin k on the lid board." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "3225189b-2051-5c07-a1e6-4633d5c09427"))
	(text "E-paper on LPSPI1 (write only)." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "09cb09ca-c39d-5f85-9772-103e555962d9"))
	(text "Touch interrupt: the FT6336U drives 3.3 V levels, the wake pad is 1.8 V. Q2 passes only the low level (gate at the" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "cf82ed24-8b5e-52e7-983a-07fb4d4f9b8f"))
	(text "    1.8 V SNVS supply); R82 pulls the pad side up to that supply." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "470862ce-69e6-5f84-9309-94e7273f4df1"))
	(text "Front light: LM3630A, two strings set independently over I2C (cool on ILED1, warm on ILED2), so no timer pad is" (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "18ce1c06-524a-5265-914b-43db6f1727dd"))
	(text "    needed. Address 0x36 on the I2C_U bus. The panel specification gives no string current or voltage: its adapter" (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "bf4ae040-1603-5b78-8739-a576db7ad7ef"))
	(text "    board feeds the strings from 15 V through resistors. START LOW (a few mA) AND MEASURE; set the 16 V limit in the" (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "259462a5-a4e3-56da-b15e-74c31311508a"))
	(text "    chip before turning the strings on (its power-on limit is 24 V; C141 is rated 50 V for that reason)." (exclude_from_sim no) (at 15.24 54.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "3679b36a-b5c6-5171-987d-835126964122"))
	(text "FL_EN and TOUCH_RST_N will come from a port expander (later sheet)." (exclude_from_sim no) (at 15.24 59.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a6d547d4-086b-5cf6-b1c2-a0101c8e316d"))
	(embedded_fonts no)
)
