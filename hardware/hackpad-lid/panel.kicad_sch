	(text "E-paper drive circuit and panel sockets" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "d0ee8701-72ff-5764-affb-d2426577287b"))
	(text "Reference circuit of the panel maker, same values: L1 47 uH, Q1 Si1308EDL, D1-D3 MBR0530, R1 1M, R2 2.2 ohm," (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "94b348dc-0341-5bc4-a6e9-158766be86dc"))
	(text "    4.7 uF / 25 V on the drive rails, 1 uF on VCI, VDD and VCOM." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "d2111be3-4e44-588e-849a-48042949c5e7"))
	(text "D1/D2 polarity follows the usual charge pump of this controller family (VGL negative): the reference drawing is" (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "4356f575-a98c-5b70-8eed-7231b3fbd6e8"))
	(text "    too coarse to read the diode direction. CHECK against a known-good board before ordering." (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "cfcf1e65-b023-5bd3-a928-2508480b7cf5"))
	(text "BS1 low = 4-wire SPI. Temperature-sensor pins 6, 7 and VPP are left open as in the reference circuit." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "65bdd66f-c9f0-5c15-8e4b-b67e9b5ddba8"))
	(text "Touch (FT6336U): 3.3 V supply; its interrupt goes to the main board, which shifts it to the 1.8 V wake pad." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f5ee8f5a-4483-5617-8401-f085dc564af1"))
	(text "Front light: two LED strings (cool, warm), driven from the main board; this board only passes them through." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "eb0c4129-6416-5269-98ba-be2fa6c0644c"))
	(text "All three panel sockets take contacts on either side of the cable (Hirose FH34SRJ, 1.0 mm high)." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f1bf410f-be49-5e44-a37e-01a650b0c3c8"))
	(embedded_fonts no)
)
