	(text "Section 3.5 assumed the RK809 codec; the CM4 connector does not carry codec pins, so a carrier codec is needed." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "89a12cc6-6f36-59f2-9cde-341f5d171409"))
	(text "ES8316 (mainline snd-soc-es8316, used on Pinebook Pro). AVDD/PVDD 3.3 V, DVDD/CPVDD 1.8 V (datasheet 6)." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "1b494e96-8c5f-5d23-92ee-4b683309612a"))
	(text "I2S straps: fit R50-R54 for LuckFox Core3566 (I2S3_M1), or R55-R59 for CM4 PCM pinout (Radxa CM4 SAI2)." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "71686dcd-72da-55d4-a3b7-5c2de6e1bde5"))
