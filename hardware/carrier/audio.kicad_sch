	(global_label "AVDD_CODEC" (shape bidirectional) (at 144.78 154.94 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "e2d47450-7115-5017-80fd-62902c3a15d2") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 144.78 154.94 0) (effects (font (size 1.27 1.27)) (hide yes))))
	(text "ES8316 codec, 3.5 mm headset jack, I2S module-variant straps" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "6d72ce99-efff-5705-8f85-ca1811ecf284"))
	(text "Approved by David 2026-11-24: carrier codec ES8316 over I2S (the RK809 codec is not on the CM4 connector)." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "8cbbd0c8-d2ea-578b-bd5d-28a85847b06b"))
	(text "ES8316 (mainline snd-soc-es8316). AVDD/PVDD 3.3 V, DVDD/CPVDD 1.8 V. CE low: I2C address 0x10. MCLK is mandatory." (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a6541320-5a07-58d9-bb5f-44bf3b5e8d81"))
	(text "Capacitors per the Everest application circuit (datasheet p.4), incl. 1u on MICBIAS and CPVDD (A4)." (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "86dde8a5-8264-5765-aead-fe73339cd7f6"))
	(text "I2S straps: fit R50-R54 for LuckFox Core3566 (I2S3_M1), or R55-R59 for the CM4 PCM pinout (Radxa CM4 SAI2)." (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "c4bbe93c-a298-50da-9fd7-74a1076e77b7"))
	(text "Jack PJ-342: tip switch (terminal 4) -> HP_DET (ES8316 GPIO1 and module pin 50). Mic contact -> GPIO2 via 15k (A5)." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f0510e6d-f7ce-5c2c-83f3-f9f91ab174ea"))
	(text "A7: the PJ-342 pole assignment of terminals 2 and 5 is inferred from the drawing. R60/R61 fitted = CTIA with" (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "cecc0786-8929-5616-b20b-063815a81b43"))
	(text "    terminal 5 = sleeve (mic). Swap to R62/R63 if a sample shows terminal 2 is the sleeve (or for OMTP headsets)." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a980bdb0-dc40-5e57-9829-55c03d70035a"))
	(text "A8: CPGNDREF senses the jack ground: HPGND joins GND only through R49, placed at the jack." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ea3cf681-d3a3-5d0a-8fcb-cfe5f906a730"))
	(embedded_fonts no)
)
