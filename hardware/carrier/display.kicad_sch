	(text "DSI panel, touch, backlight" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "f74ca11a-0a9b-5984-b702-4069cd7f8a95"))
	(text "Panel: Focus LCDs E40RB-I-MW430-CB (4.0\" 480x800 IPS, ST7701S, 2-lane DSI; touch GT911)." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "2436eeb6-0dba-5359-a3e8-0f32e613badd"))
	(text "Pinouts from the Focus spec, page 3. Both tails fold behind the panel, contacts toward the carrier, and" (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "7fc08a0a-0369-5d41-a414-b01e6611ad9a"))
	(text "plug into J4/J5 on the carrier side that faces the display: pin k of the tail = pin k of the connector" (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "54019a29-6316-5c5d-80cb-113ca744c83e"))
	(text "(FH34SRJ accepts top or bottom contact). TODO(verify) the fold and pin order on the real panel." (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "36c9b330-cb76-5816-a6b1-9e033dd6ed08"))
	(text "VCI = IOVCC = 3.3 V (IOVCC 1.65-3.3 V allowed), so RESET/TE match the 3.3 V GPIO bank." (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f082e652-9148-5302-b385-92db3d512ea0"))
	(text "Backlight: 8 LEDs as 4S2P, 12.8 V, 40 mA typical. TPS61169: 204 mV / 5.1R = 40 mA at full PWM." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ae30199c-68ea-5403-9ddf-4249070d4dc8"))
	(text "P15: the TPS61169 needs PWM between 5 and 100 kHz on CTRL; set the period in the device tree." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "37bebbc4-ce8f-5e2e-ba42-04dbb5b4fcce"))
	(text "Route DSI as 100 ohm differential pairs (net class DSI)." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f38fcc45-32f8-5e85-bf9b-e6a6060252d1"))
