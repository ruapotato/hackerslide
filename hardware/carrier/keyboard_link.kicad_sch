	(text "Keyboard FPC (I2C scanner), slider sensor" (exclude_from_sim no) (at 15.24 15.24 0) (effects (font (size 3.0 3.0)) (justify left bottom)) (uuid "01848b04-7476-5184-ad1c-7fe37f55c4f4"))
	(text "Keyboard scanner: TI TCA8418 on the keyboard PCB (I2C 0x34, mainline tca8418_keypad). No USB hub or mux." (exclude_from_sim no) (at 15.24 21.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "767af2db-c4f5-5033-a5bd-65b9832b6f6b"))
	(text "A1: J9 (carrier, facing down) and keyboard J1 (on top of the keyboard board) are the same connector with" (exclude_from_sim no) (at 15.24 25.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "f948cb69-1b4f-54ff-8678-42491998cc73"))
	(text "    pin 1 toward the device left, and the cable runs straight in X: down through the back-shell slot, back" (exclude_from_sim no) (at 15.24 29.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "8482e912-53e3-5b2c-ba1d-811ba3a67930"))
	(text "    under the body, rolling loop, into J1. So J9 pin k = J1 pin k. The cable reaches J1 with its other face" (exclude_from_sim no) (at 15.24 33.84 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "0abedaf9-f000-545c-9108-4341c6d9886e"))
	(text "    up, which the top+bottom-contact FH34SRJ accepts. Power and ground are mirror-symmetric (1/8 GND," (exclude_from_sim no) (at 15.24 38.04 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "6e179222-d2f1-5527-b759-8c76055ccdd8"))
	(text "    2/7 +3V3): a reversed cable swaps signals but cannot short the supply. TODO(verify) on the fit mule." (exclude_from_sim no) (at 15.24 42.24 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "b9272f10-01ad-5aff-8abc-9f9420206b8b"))
	(text "A2: U10 senses a dedicated 5 x 2 mm magnet in the tray, on the sensor axis when the slider is closed." (exclude_from_sim no) (at 15.24 46.44 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "27fa2a4c-f810-56aa-8e2e-5c0f5e7b9fb2"))
	(text "    DRV5032FA: operate <= 4.8 mT, release >= 0.5 mT, push-pull, output low with field. See docs/enclosure.md." (exclude_from_sim no) (at 15.24 50.64 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "5ef7b971-e3ee-5afe-ad66-bb56955ea356"))
	(embedded_fonts no)
)
